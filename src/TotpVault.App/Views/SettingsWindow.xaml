<Window x:Class="TotpVault.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Window.Dialog}"
        Background="{StaticResource Brush.Background}"
        Title="設定"
        Width="540"
        MaxHeight="760">
    <Window.Resources>
        <Style x:Key="SettingTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SettingDescription" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="Margin" Value="0,2,12,0"/>
        </Style>
        <Style x:Key="RowDivider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{StaticResource Brush.Border}"/>
            <Setter Property="Margin" Value="0,12"/>
        </Style>
        <Style x:Key="InfoKey" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="Margin" Value="0,3,16,3"/>
        </Style>
        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,1,0,0" Padding="24,12">
            <Button Content="閉じる" MinWidth="100" HorizontalAlignment="Right" IsCancel="True" IsDefault="True"/>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="24,20,24,16">
                <TextBlock Text="設定" Style="{StaticResource Text.Title}"/>

                <!-- セキュリティ -->
                <TextBlock Text="セキュリティ" Style="{StaticResource Text.Section}" Margin="2,18,0,8"/>
                <Border Style="{StaticResource Card}" Padding="18,16">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="自動ロック" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="一定時間操作がない場合に自動的にロックします。" Style="{StaticResource SettingDescription}"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="150" VerticalAlignment="Center"
                                      ItemsSource="{Binding AutoLockOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding AutoLockMinutes}"/>
                        </Grid>
                        <Border Style="{StaticResource RowDivider}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="クリップボードの自動消去" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Style="{StaticResource SettingDescription}"
                                           Text="コピーした認証コードを指定時間後に消去します。その間に別のアプリでコピーした内容は消去しません。"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="150" VerticalAlignment="Center"
                                      ItemsSource="{Binding ClipboardOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding ClipboardClearSeconds}"/>
                        </Grid>
                        <Border Style="{StaticResource RowDivider}"/>
                        <CheckBox IsChecked="{Binding LockOnSessionLock}">
                            <StackPanel>
                                <TextBlock Text="Windows のロック・スリープ時にロックする" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="Win + L やスリープで席を離れたときに自動的にロックします。" Style="{StaticResource SettingDescription}"/>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox IsChecked="{Binding LockOnMinimize}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="最小化したときにロックする" Style="{StaticResource SettingTitle}"/>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox IsChecked="{Binding HideFromScreenCapture}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="画面キャプチャ・画面共有に表示しない" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Style="{StaticResource SettingDescription}"
                                           Text="スクリーンショットや Web 会議の画面共有に、このアプリのウィンドウが映らないようにします。"/>
                            </StackPanel>
                        </CheckBox>
                        <Border Style="{StaticResource RowDivider}"/>
                        <Button HorizontalAlignment="Left" Command="{Binding ChangePasswordCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8D7;" FontFamily="{StaticResource Font.Icon}" VerticalAlignment="Center"/>
                                <TextBlock Text="マスターパスワードを変更…" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- バックアップ -->
                <TextBlock Text="バックアップ" Style="{StaticResource Text.Section}" Margin="2,20,0,8"/>
                <Border Style="{StaticResource Card}" Padding="18,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Secondary}"
                                   Text="バックアップファイルは専用のパスワードで暗号化されます（AES-256-GCM）。別のPCへの移行や、パスワードを忘れた場合の復旧に使用できます。"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="最終バックアップ:" Style="{StaticResource Text.Caption}"/>
                            <TextBlock Text="{Binding LastBackupText}" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0"/>
                        </StackPanel>
                        <Border Style="{StaticResource Callout.Warning}" Margin="0,10,0,0"
                                Visibility="{Binding BackupRecommended, Converter={StaticResource BoolToVis}}">
                            <TextBlock FontSize="12" Foreground="#7C4A03" TextWrapping="Wrap"
                                       Text="バックアップを作成しておくと、PCの故障やパスワード忘れの際にもアカウントを復旧できます。"/>
                        </Border>
                        <WrapPanel Margin="0,12,0,0">
                            <Button Style="{StaticResource Button.Primary}" Command="{Binding ExportBackupCommand}" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE898;" FontFamily="{StaticResource Font.Icon}" VerticalAlignment="Center"/>
                                    <TextBlock Text="バックアップを作成…" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ImportBackupCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource Font.Icon}" VerticalAlignment="Center"/>
                                    <TextBlock Text="バックアップから復元…" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- データ -->
                <TextBlock Text="データ" Style="{StaticResource Text.Section}" Margin="2,20,0,8"/>
                <Border Style="{StaticResource Card}" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="保存場所" Style="{StaticResource Text.Label}"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="開く" Margin="8,0,0,0" Command="{Binding OpenDataFolderCommand}"/>
                            <TextBox Text="{Binding DataDirectory, Mode=OneWay}" IsReadOnly="True" FontSize="12"/>
                        </DockPanel>
                        <Border Style="{StaticResource RowDivider}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="保管庫の初期化" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="すべてのアカウントを削除し、初期状態に戻します。" Style="{StaticResource SettingDescription}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource Button.DangerOutline}" Content="初期化…"
                                    VerticalAlignment="Center" Command="{Binding ResetVaultCommand}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- セキュリティ情報 -->
                <TextBlock Text="セキュリティ情報" Style="{StaticResource Text.Section}" Margin="2,20,0,8"/>
                <Border Style="{StaticResource Card}" Padding="18,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="暗号方式" Style="{StaticResource InfoKey}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource InfoValue}" Text="AES-256-GCM（認証付き暗号・アカウントごとに個別暗号化）"/>
                        <TextBlock Grid.Row="1" Text="鍵導出" Style="{StaticResource InfoKey}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource InfoValue}" Text="{Binding KdfText}"/>
                        <TextBlock Grid.Row="2" Text="端末保護" Style="{StaticResource InfoKey}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource InfoValue}" Text="Windows DPAPI（現在のWindowsユーザーに紐付け）"/>
                        <TextBlock Grid.Row="3" Text="保存データ" Style="{StaticResource InfoKey}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource InfoValue}" Text="SQLite（サービス名・アカウント名も暗号化）"/>
                        <TextBlock Grid.Row="4" Text="メモリ" Style="{StaticResource InfoKey}"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource InfoValue}" Text="シークレットはコード生成時のみ復号し、直後に消去"/>
                        <TextBlock Grid.Row="5" Text="ログ" Style="{StaticResource InfoKey}"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource InfoValue}" Text="シークレット・コード・パスワードは記録しません"/>
                        <TextBlock Grid.Row="6" Grid.ColumnSpan="2" Text="{Binding VersionText}" Style="{StaticResource Text.Caption}" Margin="0,10,0,0"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
