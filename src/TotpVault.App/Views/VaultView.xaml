<UserControl x:Class="TotpVault.App.Views.VaultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TotpVault.App.ViewModels"
             xmlns:controls="clr-namespace:TotpVault.App.Controls"
             Focusable="True"
             FocusVisualStyle="{x:Null}">
    <UserControl.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding AddManualCommand}"/>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding AddFromImageCommand}"/>
        <KeyBinding Key="L" Modifiers="Ctrl" Command="{Binding LockCommand}"/>
    </UserControl.InputBindings>

    <UserControl.Resources>
        <!-- アカウントカード -->
        <DataTemplate x:Key="AccountTemplate" DataType="{x:Type vm:AccountItemViewModel}">
            <Button x:Name="CardRoot" Style="{StaticResource Button.Card}" Margin="0,0,0,8"
                    Command="{Binding CopyCommand}" ToolTip="クリックでコードをコピー">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="コードをコピー" Tag="&#xE8C8;" Command="{Binding CopyCommand}"/>
                        <MenuItem Header="編集…" Tag="&#xE70F;" Command="{Binding EditCommand}"/>
                        <MenuItem Header="{Binding FavoriteMenuText}" Tag="&#xE734;" Command="{Binding ToggleFavoriteCommand}"/>
                        <Separator/>
                        <MenuItem Header="上へ移動" Tag="&#xE70E;" Command="{Binding MoveUpCommand}"/>
                        <MenuItem Header="下へ移動" Tag="&#xE70D;" Command="{Binding MoveDownCommand}"/>
                        <Separator/>
                        <MenuItem Header="削除…" Tag="&#xE74D;" Command="{Binding DeleteCommand}" Style="{StaticResource MenuItem.Danger}"/>
                    </ContextMenu>
                </Button.ContextMenu>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="40" Height="40" CornerRadius="20" VerticalAlignment="Top" Margin="0,2,0,0"
                            Background="{Binding AvatarBrush}">
                        <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="SemiBold" FontSize="17"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,8,0">
                        <DockPanel LastChildFill="True">
                            <Border x:Name="CopiedBadge" DockPanel.Dock="Right" Visibility="Collapsed" Margin="6,0,0,0"
                                    Background="{StaticResource Brush.SuccessSoft}" CornerRadius="9" Padding="7,1" VerticalAlignment="Center">
                                <TextBlock Text="コピーしました" FontSize="11" Foreground="{StaticResource Brush.Success}"/>
                            </Border>
                            <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{StaticResource Brush.Text}" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <TextBlock Text="{Binding DisplaySubtitle}" FontSize="12" Foreground="{StaticResource Brush.TextSecondary}"
                                   TextTrimming="CharacterEllipsis" Margin="0,1,0,0"
                                   Visibility="{Binding DisplaySubtitle, Converter={StaticResource StringToVis}}"/>
                        <TextBlock x:Name="CodeText" Text="{Binding FormattedCode}" FontFamily="{StaticResource Font.Mono}"
                                   FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource Brush.Accent}" Margin="0,4,0,0"/>
                        <WrapPanel>
                            <TextBlock Text="{Binding NextCodeText}" FontSize="12" Foreground="{StaticResource Brush.TextMuted}" Margin="0,0,10,0"
                                       Visibility="{Binding ShowNextCode, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="{Binding ParametersText}" FontSize="11" Foreground="{StaticResource Brush.TextMuted}"
                                       Visibility="{Binding ParametersText, Converter={StaticResource StringToVis}}"/>
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <Grid Width="40" Height="40" HorizontalAlignment="Center" ToolTip="次のコードまでの残り秒数">
                            <controls:CountdownRing x:Name="Ring" Progress="{Binding Progress}" StrokeThickness="3.5"
                                                    RingBrush="{StaticResource Brush.Accent}" TrackBrush="{StaticResource Brush.Border}"/>
                            <TextBlock x:Name="SecondsText" Text="{Binding SecondsRemaining}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Style="{StaticResource Button.IconSmall}" Command="{Binding ToggleFavoriteCommand}" ToolTip="お気に入り">
                                <TextBlock FontFamily="{StaticResource Font.Icon}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#xE734;"/>
                                            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                    <Setter Property="Text" Value="&#xE735;"/>
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Star}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                            <Button Style="{StaticResource Button.IconSmall}" Content="&#xE712;" ToolTip="その他の操作"
                                    Tag="{Binding ElementName=CardRoot}" Click="OnMoreClick"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsExpiring}" Value="True">
                    <Setter TargetName="CodeText" Property="Foreground" Value="{StaticResource Brush.Danger}"/>
                    <Setter TargetName="Ring" Property="RingBrush" Value="{StaticResource Brush.Danger}"/>
                    <Setter TargetName="SecondsText" Property="Foreground" Value="{StaticResource Brush.Danger}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCopied}" Value="True">
                    <Setter TargetName="CopiedBadge" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- ヘッダー -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,0,0,1" Padding="16,14,12,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="/Assets/logo.png" Width="32" Height="32" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="TOTP Vault" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding AccountCountText}" Style="{StaticResource Text.Caption}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="AddButton" Style="{StaticResource Button.Primary}" Padding="12,6" Click="OnAddClick"
                                ToolTip="アカウントを追加">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource Font.Icon}" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="追加" Margin="6,0,2,0" VerticalAlignment="Center"/>
                                <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Font.Icon}" FontSize="9" Margin="4,1,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="画面上のQRコードをスキャン" Tag="&#xE7F4;" Command="{Binding AddFromScreenCommand}"/>
                                    <MenuItem Header="QRコード画像を選択…" Tag="&#xE8B9;" Command="{Binding AddFromImageCommand}" InputGestureText="Ctrl+O"/>
                                    <MenuItem Header="クリップボードから貼り付け" Tag="&#xE77F;" Command="{Binding AddFromClipboardCommand}" InputGestureText="Ctrl+V"/>
                                    <Separator/>
                                    <MenuItem Header="シークレットキーを手動で入力…" Tag="&#xE765;" Command="{Binding AddManualCommand}" InputGestureText="Ctrl+N"/>
                                    <Separator/>
                                    <MenuItem Header="バックアップから復元…" Tag="&#xE896;" Command="{Binding ImportBackupCommand}"/>
                                    <MenuItem Header="バックアップを作成…" Tag="&#xE898;" Command="{Binding ExportBackupCommand}"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Style="{StaticResource Button.Icon}" Content="&#xE713;" Margin="6,0,0,0" ToolTip="設定"
                                Command="{Binding OpenSettingsCommand}"/>
                        <Button Style="{StaticResource Button.Icon}" Content="&#xE72E;" ToolTip="今すぐロック (Ctrl+L)"
                                Command="{Binding LockCommand}"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,12,0,0" Visibility="{Binding HasAccounts, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="サービス名・アカウント名で検索" Padding="34,8,32,8" KeyDown="OnSearchKeyDown"/>
                        <TextBlock Text="&#xE721;" Style="{StaticResource Text.Icon}" FontSize="14" Foreground="{StaticResource Brush.TextMuted}"
                                   HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False"/>
                        <Button Style="{StaticResource Button.IconSmall}" Content="&#xE711;" FontSize="11" Width="26" Height="26"
                                HorizontalAlignment="Right" Margin="0,0,5,0" ToolTip="検索をクリア"
                                Command="{Binding ClearSearchCommand}"
                                Visibility="{Binding SearchText, Converter={StaticResource StringToVis}}"/>
                    </Grid>
                    <ComboBox Grid.Column="1" Margin="8,0,0,0" Width="118" ToolTip="並び順"
                              ItemsSource="{Binding SortOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding SortMode}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- フッター -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,1,0,0" Padding="16,7">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE72E;" Style="{StaticResource Text.Icon}" FontSize="11" Foreground="{StaticResource Brush.Success}"/>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Caption}" Margin="6,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 一覧 -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,14,14,6" Focusable="False">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="4,0,0,8" Visibility="{Binding HasFavorites, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="&#xE735;" Style="{StaticResource Text.Icon}" FontSize="11" Foreground="{StaticResource Brush.Star}"/>
                    <TextBlock Text="お気に入り" Style="{StaticResource Text.Section}" Margin="6,0,0,0"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Favorites}" ItemTemplate="{StaticResource AccountTemplate}" Focusable="False"/>

                <TextBlock Text="すべてのアカウント" Style="{StaticResource Text.Section}" Margin="4,8,0,8"
                           Visibility="{Binding ShowOthersHeader, Converter={StaticResource BoolToVis}}"/>
                <ItemsControl ItemsSource="{Binding Others}" ItemTemplate="{StaticResource AccountTemplate}" Focusable="False"/>

                <!-- 未登録時 -->
                <Border Style="{StaticResource Card}" Padding="24,28" Margin="0,6,0,0"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <StackPanel Width="300" HorizontalAlignment="Center">
                        <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource Brush.AccentSoft}" HorizontalAlignment="Center">
                            <TextBlock Text="&#xED14;" Style="{StaticResource Text.Icon}" FontSize="28" Foreground="{StaticResource Brush.Accent}"/>
                        </Border>
                        <TextBlock Text="アカウントがまだありません" Style="{StaticResource Text.Heading}" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                        <TextBlock Style="{StaticResource Text.Secondary}" TextAlignment="Center" Margin="0,6,0,0"
                                   Text="各サービスの2段階認証の設定画面に表示されるQRコードから登録できます。"/>
                        <Button Style="{StaticResource Button.Primary}" Margin="0,18,0,0" Command="{Binding AddFromScreenCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource Font.Icon}" VerticalAlignment="Center"/>
                                <TextBlock Text="画面上のQRコードをスキャン" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Margin="0,8,0,0" Command="{Binding AddFromImageCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B9;" FontFamily="{StaticResource Font.Icon}" VerticalAlignment="Center"/>
                                <TextBlock Text="QRコード画像を選択" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Margin="0,8,0,0" Command="{Binding AddManualCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE765;" FontFamily="{StaticResource Font.Icon}" VerticalAlignment="Center"/>
                                <TextBlock Text="シークレットキーを手動で入力" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Button.Link}" Margin="0,12,0,0" HorizontalAlignment="Center"
                                Content="バックアップから復元" Command="{Binding ImportBackupCommand}"/>
                        <TextBlock Style="{StaticResource Text.Caption}" TextAlignment="Center" Margin="0,14,0,0"
                                   Text="ヒント: QRコード画像をウィンドウにドラッグ＆ドロップ、またはスクリーンショットを Ctrl+V で貼り付けても登録できます。"/>
                    </StackPanel>
                </Border>

                <!-- 検索結果なし -->
                <StackPanel Margin="0,40,0,0" Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="&#xE721;" Style="{StaticResource Text.Icon}" FontSize="30" Foreground="{StaticResource Brush.TextMuted}"/>
                    <TextBlock Text="{Binding NoResultsText}" Style="{StaticResource Text.Secondary}" TextAlignment="Center" Margin="0,12,0,0"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
