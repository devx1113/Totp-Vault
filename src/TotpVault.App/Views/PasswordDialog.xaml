<Window x:Class="TotpVault.App.Views.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TotpVault.App.Controls"
        Style="{StaticResource Window.Dialog}"
        Title="TOTP Vault"
        Width="440">
    <StackPanel Margin="24,22,24,20">
        <TextBlock x:Name="TitleText" Style="{StaticResource Text.Heading}"/>
        <TextBlock x:Name="DescriptionText" Style="{StaticResource Text.Secondary}" Margin="0,6,0,0"/>

        <StackPanel x:Name="CurrentPanel" Margin="0,18,0,0">
            <TextBlock x:Name="CurrentLabel" Style="{StaticResource Text.Label}" Text="現在のマスターパスワード"/>
            <PasswordBox x:Name="CurrentBox" PasswordChanged="OnAnyPasswordChanged"/>
        </StackPanel>

        <StackPanel x:Name="NewPanel" Margin="0,16,0,0">
            <TextBlock x:Name="NewLabel" Style="{StaticResource Text.Label}" Text="新しいパスワード"/>
            <PasswordBox x:Name="NewBox" PasswordChanged="OnNewPasswordChanged"/>
            <controls:StrengthMeter x:Name="Meter" Margin="0,8,0,0"/>
        </StackPanel>

        <StackPanel x:Name="ConfirmPanel" Margin="0,8,0,0">
            <TextBlock Style="{StaticResource Text.Label}" Text="確認のためもう一度入力"/>
            <PasswordBox x:Name="ConfirmBox" PasswordChanged="OnAnyPasswordChanged"/>
        </StackPanel>

        <TextBlock x:Name="CapsLockText" Margin="0,10,0,0" FontSize="12" Foreground="{StaticResource Brush.Warning}"
                   Text="⚠ Caps Lock がオンになっています" Visibility="Collapsed"/>
        <TextBlock x:Name="ErrorText" Style="{StaticResource Text.Error}" Margin="0,12,0,0" Visibility="Collapsed"/>

        <ProgressBar x:Name="BusyBar" IsIndeterminate="True" Height="3" Margin="0,16,0,0" Visibility="Hidden"
                     Foreground="{StaticResource Brush.Accent}" Background="Transparent" BorderThickness="0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="CancelButton" MinWidth="100" IsCancel="True" Content="キャンセル"/>
            <Button x:Name="OkButton" MinWidth="100" Margin="8,0,0,0" IsDefault="True" Click="OnOk"
                    Style="{StaticResource Button.Primary}" Content="OK"/>
        </StackPanel>
    </StackPanel>
</Window>
