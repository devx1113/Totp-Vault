<UserControl x:Class="TotpVault.App.Controls.StrengthMeter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <UniformGrid Columns="4" Height="4">
            <Border x:Name="Bar1" CornerRadius="2" Margin="0,0,3,0" Background="{StaticResource Brush.Border}"/>
            <Border x:Name="Bar2" CornerRadius="2" Margin="0,0,3,0" Background="{StaticResource Brush.Border}"/>
            <Border x:Name="Bar3" CornerRadius="2" Margin="0,0,3,0" Background="{StaticResource Brush.Border}"/>
            <Border x:Name="Bar4" CornerRadius="2" Background="{StaticResource Brush.Border}"/>
        </UniformGrid>
        <TextBlock x:Name="LabelText" Style="{StaticResource Text.Caption}" Margin="0,5,0,0" Text=" "/>
    </StackPanel>
</UserControl>
